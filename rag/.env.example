# Only needed if you run the assistant as a separate server (python -m rag.start).
# The Streamlit dashboard reads the same keys from .streamlit/secrets.toml instead.

# One key; provider detected from prefix: xai- (Grok), gsk_ (Groq), prune_ (Prune), sk- (OpenAI)
LLM_API_KEY=xai-xxxxxxxxxxxxxxxx
# LLM_MODEL=grok-3-mini

BACKEND_URL=http://localhost:8000
AGENT_TOKEN=
RAG_REDACT_NAMES=false
