# Environment for the RAG agent. Locally: set these in the terminal (see README).
# On Maritime:  maritime env set aegisgate-rag KEY=value

PRUNE_API_KEY=prune_xxxxxxxxxxxxxxxx
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_MODEL=gpt-4o-mini

# Where the backend is reachable FROM the agent (ngrok URL when the agent runs on Maritime)
BACKEND_URL=http://localhost:8000

# Optional shared secret; the dashboard sends it as X-Agent-Token
AGENT_TOKEN=
RAG_REDACT_NAMES=false
