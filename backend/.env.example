# Copy to backend/.env and edit. All values are optional.

GATE_ID=gate-01

# Empty = local SQLite (backend/data/aegisgate.db).
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler", then
# change the prefix to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

SESSION_WINDOW_S=8
CAMERA_GRACE_S=3
UNAUTH_DECISION_DELAY_S=2
ALLOWED_PER_TAP=1
FORCED_DOOR_WINDOW_S=6
HELD_OPEN_THRESHOLD_S=10
HELD_OPEN_REQUIRES_CLOSE_EVENT=true
AUTHORIZE_BY_HOLDER_NAME=true

# Set this before exposing the backend publicly (ngrok). The dashboard must send the same
# value (CONTROL_TOKEN in .streamlit/secrets.toml) to run demo scenarios / reset.
CONTROL_TOKEN=
