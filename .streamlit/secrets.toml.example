# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
# Never commit the real secrets.toml.

# Public URL of the FastAPI backend (ngrok / cloudflared URL when the dashboard is on Streamlit Cloud)
BACKEND_URL = "http://localhost:8000"

# Assistant runs inside this Streamlit app.
RAG_URL = "embedded"

# Paste your LLM key here. Provider is detected from the prefix:
#   xai-...  = xAI Grok     gsk_... = Groq     prune_... = Prune     sk-... = OpenAI
LLM_API_KEY = "prune_1sKaj1jX9aTZrbvH66BMMWn5DGMiDHvz"
# Optional: force a model, e.g. "grok-3-mini" or "llama-3.3-70b-versatile". Empty = auto-pick.
LLM_MODEL = ""

# Optional shared secrets — must match the backend's CONTROL_TOKEN and the agent's AGENT_TOKEN
CONTROL_TOKEN = ""
AGENT_TOKEN = ""

# "auto" = smooth MJPEG stream on localhost, 1 fps server-side polling elsewhere
CAMERA_MODE = "auto"
TIMEZONE = "Asia/Kolkata"
